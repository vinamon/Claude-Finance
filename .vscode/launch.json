{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Test connection (Bybit demo)",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_connection.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Test ntfy push",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/scripts/test_ntfy.py",
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Single run",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--once"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "4. Single run, FORCE a test entry",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--once", "--force-entry"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    },
    {
      "name": "5. Loop every 5 minutes",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/run.py",
      "args": ["--loop"],
      "console": "integratedTerminal",
      "cwd": "${workspaceFolder}"
    }
  ]
}
