# Copy this file to ".env" and fill in the three secrets. .env is gitignored
# and must never be committed.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# EVERY setting the bot has is listed here, and every one of them is read
# through config.py at startup. No period, threshold, multiplier or boolean is
# hardcoded anywhere in the code, so this file is the whole control panel:
# change a value, restart, done.
#
# The values below are a coherent starting set. They are textbook systems with
# published track records, not edges we discovered. Assume they lose money
# after fees until your own backtest says otherwise.

# --- secrets -----------------------------------------------------------------
# Generated in Bybit AFTER switching to Demo Trading. Keys from the real
# account will not work on the demo host, by design.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Long random string, letters/digits/dash/underscore only, 1-64 chars.
# Subscribe to exactly this string in the ntfy app.
NTFY_TOPIC=

# --- scheduling --------------------------------------------------------------
# AUTOSTART is NOT a Windows/macOS autostart. It only decides what plain
# "python run.py" does. Nothing in this project registers itself with the
# operating system, so the bot does not come back by itself after a reboot.
#   true  = "python run.py" keeps cycling
#   false = "python run.py" does one cycle and exits
# Command line always wins: --loop / --once override this.
AUTOSTART=false

# Minutes between cycles in loop mode. Safe to change freely: decisions are
# made on CLOSED candles, so polling faster only means noticing a closed bar
# sooner, never a different decision. Faster polling does mean more API calls;
# at these numbers that is nowhere near any Bybit limit.
LOOP_INTERVAL_MINUTES=1

# Seconds per idempotency bucket for orderLinkId. Two entry attempts inside
# one bucket produce the same client order id and Bybit rejects the duplicate,
# which is what stops an ambiguous timeout from opening a second position.
# Leave this commented out and it follows LOOP_INTERVAL_MINUTES automatically,
# which is what you want: a bucket LONGER than the interval blocks a cycle
# that legitimately wants to retry until the bucket rolls over.
# ORDER_BUCKET_SECONDS=120

# --- safety ------------------------------------------------------------------
# true ignores the market completely and only enters with --force-entry.
DUMMY_MODE=false

# --- what to trade -----------------------------------------------------------
# Comma separated, ccxt format.
#
# More symbols is the most effective way to get more trades without loosening
# a single rule. The same strategy across ten markets fires roughly ten times
# as often as on one, and those trades are far less correlated than the extra
# ones you would get by lowering a threshold on a single market.
SYMBOLS=BTC/USDT:USDT,ETH/USDT:USDT,XRP/USDT:USDT,SOL/USDT:USDT,ZEC/USDT:USDT,NEAR/USDT:USDT,HYPE/USDT:USDT,DOGE/USDT:USDT,1000PEPE/USDT:USDT,BCH/USDT:USDT

# THE SYMBOL LIST IS THE TEN MOST LIQUID CRYPTO PERPETUALS, MEASURED.
# Ranked by 24h turnover straight from the exchange on 2026-09-24, then
# filtered by hand to crypto only. The raw ranking includes tokenized equities
# and commodities - SOXL, crude (CL) and gold (XAU) sat in that day's top
# twelve - which trade on a different clock and a different logic than
# anything these strategies were built for. Nothing in the API metadata marks
# them, so they are excluded by name rather than guessed at.
#
# Ten, not forty: on 15-minute candles ten symbols already give about 25
# entries a day, and the most liquid markets are the ones where a market
# order fills close to the price its stop was measured from. The ranking
# moves from day to day; re-measure it rather than trusting this list forever.

# trend | meanrev | breakout | scalp | multi
# "multi" runs everything in ACTIVE_STRATEGIES at once.
STRATEGY=multi

# Which strategies are live under STRATEGY=multi, in PRIORITY order. When more
# than one fires on the same bar the FIRST listed owns the position, and its
# exit rule is what will eventually close it. That matters: closing a
# mean-reversion trade on a trend-following rule ruins both strategies.
ACTIVE_STRATEGIES=trend,breakout,meanrev,scalp

# How many strategies must agree before a position opens.
#   1 = any signal trades. Most trades, which is what a demo account is for.
#   2+ = demand confluence. Far fewer trades, better supported.
MIN_ENTRY_VOTES=1

# Ceiling on simultaneous open positions, so a day when everything breaks out
# at once cannot put the whole account into one direction. Symbols are
# considered in SYMBOLS order. 0 = no cap. One position per symbol means ten
# symbols can never hold more than ten anyway: 10 x 450 = 4,500 USDT of
# notional at most, against a 50,000 demo balance.
MAX_OPEN_POSITIONS=10

# Per-strategy ceiling, as "name:count", e.g. "scalp:6,trend:3". Empty = no
# per-strategy cap. It only earns its place when strategies run on DIFFERENT
# timeframes: a 15-minute rule fires many times more often than an hourly one,
# reaches every free slot first, and the slow rule never gets to trade. With
# every strategy on the same clock there is nothing to protect.
MAX_OPEN_PER_STRATEGY=

# Per-strategy timeframe, as "name:timeframe", e.g. "trend:1h". Anything not
# listed runs on ENTRY_TIMEFRAME. Empty = one clock for everything. This is
# what lets one bot hold a swing book and a scalping book at the same time,
# in the same cycle, against the same account - pair it with
# MAX_OPEN_PER_STRATEGY if you do.
STRATEGY_TIMEFRAMES=

# --- position size and leverage ----------------------------------------------
# Notional = qty * price, NOT the margin you put up.
# Margin used is roughly notional / leverage.
#
# THESE TWO LINES ARE READ TOGETHER. Margin = notional / leverage, so
# 450 / 15 = 30 USDT of your own money per position. That pairing is the
# point: change one without the other and the money at risk changes too.
#
# 450 also clears Bybit's minimum lot everywhere with room to spare. The
# binding symbol is BTC, where one 0.001 lot costs roughly 76 USDT at current
# prices - a notional under that gets the order REFUSED outright, not resized.
POSITION_NOTIONAL_USDT=450

# Leverage does NOT change the position size above. It changes how little
# margin backs it, which is to say how close liquidation sits: roughly
# 100/leverage percent from entry, so 15x puts it about 6.7% away.
#
# THAT NUMBER MUST STAY CLEAR OF THE STOP LOSS, or the exchange liquidates the
# position before your own stop can fire and Bybit replaces your risk
# management with its own. MAX_STOP_FRACTION_OF_LIQUIDATION below caps every
# stop at half that distance, 3.33% at 15x.
#
# Measured on 26 days of 15-minute candles across these ten symbols, the
# median 3xATR stop runs from 0.78% (BTC) to 2.92% (NEAR), all inside the cap.
# In violent spells it does not fit: NEAR's reached 11%. There the cap pulls
# the stop in, and MIN_STOP_ATR_MULT skips the trade when that leaves less
# than one ATR. Raising leverage shrinks the cap and turns that from the
# exception into the rule.
LEVERAGE=15

# --- timeframes --------------------------------------------------------------
# 15-minute candles for every strategy: positions last about three hours on
# average in the replay, and ten symbols give roughly 25 entries a day. On
# 15m, EMA20 is five hours of history, EMA50 about twelve, and the 200-period
# regime line about two days. Hourly candles gave a swing book that could sit
# for days between trades.
ENTRY_TIMEFRAME=15m

# EXIT_TIMEFRAME is deliberately absent. Leaving it unset makes the exit
# inherit ENTRY_TIMEFRAME, which is the only way the exit mirrors the entry:
# same indicator, same periods, same amount of history. Setting it shorter
# means the exit reads a fraction of the data the entry used and will close
# positions the entry trend still endorses, paying fees each time.

# How many recently closed candles to scan for a signal event.
SIGNAL_LOOKBACK_BARS=3

# --- regime filter: the gate every strategy passes through --------------------
# Long entries only while price is above this average.
#
# This is what makes running several strategies together coherent rather than
# self-defeating. Trend following buys strength, mean reversion buys weakness;
# side by side without a filter, one strategy's entry is the other's exit.
# With it, mean reversion becomes "buy the dip INSIDE an uptrend" - the
# well-documented version - and they all pull the same way, differing only in
# what triggers the entry.
#
# It is a condition checked every cycle, not a crossing to wait for: on 15m
# the line is about two days of trend, and entries are allowed whenever price
# sits above it.
REGIME_FILTER=true
REGIME_PERIOD=200

# Close any open position, whoever opened it, when price falls back under the
# regime average. OFF: replayed over 26 days on these ten symbols, turning it
# off improved results in both halves of the sample. The dip buyers (meanrev,
# scalp) enter exactly when price sags toward that line, so this exit mostly
# threw out trades that were about to work. The exchange-side stop loss is
# the real protection. The filter above still blocks NEW entries below it.
EXIT_ON_REGIME_BREAK=false

# What to do with a position whose owning strategy is unknown - opened by
# hand, or state/owners.json was lost.
#   any    = close as soon as any active strategy wants out (safest)
#   all    = wait for unanimity
#   regime = leave it to the regime break and the exchange-side stops
UNKNOWN_OWNER_EXIT=any

# --- strategy 1: trend - EMA crossover confirmed by ADX ----------------------
# Shorter and exponential rather than the classic SMA 50/200, which is a DAILY
# signal: on an intraday chart 50/200 fires once in months.
EMA_FAST_PERIOD=20
EMA_SLOW_PERIOD=50

# ADX measures trend STRENGTH and has no opinion on direction. A bare moving
# average crossover bleeds in sideways markets because it fires on every
# wiggle; demanding ADX above a floor is the standard fix for exactly that.
# Below about 20 is conventionally "no trend". ADX_MIN=0 disables the filter.
ADX_PERIOD=14
ADX_MIN=20

# --- strategy 2: meanrev - short-RSI pullback inside an uptrend ---------------
# A 2-period RSI, not the usual 14. The short period is what makes this the
# Connors "RSI-2" pullback pattern rather than a slow oscillator: it collapses
# into single digits on an ordinary pullback and recovers within a bar or two,
# which is precisely the move being bought. Paired with REGIME_FILTER it buys
# weakness inside strength; without that filter it catches falling knives.
#
# Honest caveat: RSI-2 was built on equity indices, which mean-revert. Crypto
# trends harder and pays mean reversion less, so expect a lower hit rate here
# than the literature quotes.
RSI_PERIOD=2
RSI_OVERSOLD=10
RSI_OVERBOUGHT=70

# Connors' own exit: leave when the close snaps back above a short average.
MEANREV_EXIT_SMA_PERIOD=5

# --- strategy 3: breakout - Donchian channel, Turtle style -------------------
# Enter on a close above the N-bar high, leave on a close below the M-bar low,
# with M SHORTER than N. The asymmetry is the original Turtle rule and it is
# the whole point: a symmetric channel gives back most of a move before
# admitting the trend is over, because a new 20-bar low arrives long after the
# trend has died.
BREAKOUT_LOOKBACK=20
BREAKOUT_EXIT_LOOKBACK=10

# --- risk model: where the stop, target and trail actually go ----------------
# atr = size every exit in the instrument's own recent volatility
# pct = flat fractions of the entry price
#
# ATR is the upgrade worth having. A flat 5% stop is a different amount of
# risk on BTC than on DOGE, and a different amount on the same coin in a calm
# week than in a violent one - so it is either too tight and gets hit by
# noise, or too wide and pays for it. ATR adapts to both. If ATR cannot be
# computed the code falls back to the percentages below automatically, so
# both sets stay meaningful.
RISK_MODEL=atr

# Stop 3 ATR, target 6 ATR. Two ATR is the textbook stop on daily candles; a
# 15-minute candle is mostly noise by comparison and needs more room.
# Replayed over 26 days on these ten symbols, 3/6 beat 2/4 in both halves of
# the sample. The target stays twice the stop: validate() refuses a target
# that is not above the stop.
ATR_PERIOD=14
ATR_STOP_MULT=3.0
ATR_TARGET_MULT=6.0
ATR_TRAIL_MULT=1.5
ATR_TRAIL_ACTIVATION_MULT=3.0

# Percentage model, and the fallback for the ATR model. 0.05 = 5%.
# Set any leg to 0 to disable it.
#
# The stop is a disaster brake, not the primary exit - the strategy's own rule
# is what normally closes a position - so it stays out of the way of noise.
# HOW CLOSE THE STOP MAY GET TO LIQUIDATION. This is not optional at
# leverage. Liquidation sits roughly 100/leverage percent from entry - 6.67%
# at 15x - and a stop beyond that never fires: the exchange closes the
# position first, takes the whole margin and charges a liquidation fee.
#
# Caught live on this account: ARB opened with a 2xATR stop 7.07% away while
# liquidation sat 5.72% away. The stop could not have worked.
#
# Measured across the forty hourly-traded symbols of the time, 2xATR ran from
# 1.24% on BTC to 27% on the wildest alt, a twentyfold spread. No single
# leverage covers that, so the stop is capped per trade at this fraction of
# the liquidation distance.
MAX_STOP_FRACTION_OF_LIQUIDATION=0.5

# When the cap squeezes the stop below this many ATR, SKIP the trade instead.
# A stop inside normal bar-to-bar movement is not protection, it is a
# scheduled exit the next candle triggers by accident. On a symbol whose ATR
# is 13% of price there is no stop that both fits inside a 15x liquidation and
# means anything, and the honest answer is not to take the trade. 0 disables.
MIN_STOP_ATR_MULT=1.0

STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Trailing stop. Bybit takes a PRICE DISTANCE, not a percentage, so this
# fraction is multiplied by the entry price before being sent.
#
# ACTIVATION MUST BE >= DISTANCE in both models, and config.validate() refuses
# to run otherwise. Bybit puts the trail's first trigger at
# (activation - distance): with 5% and 3% that lands 2% ABOVE entry, so arming
# the trail locks in a profit. Reverse them and it lands below entry, turning
# the trail into an early loss that fires before the stop loss ever would.
# Observed live at 1% activation with a 1.5% distance: the trail sat 0.49%
# UNDER the entry price. The same arithmetic governs the ATR multipliers.
TRAILING_STOP_PCT=0.03
TRAILING_ACTIVATION_PCT=0.05

# --- candle budget -----------------------------------------------------------
# Wilder-smoothed indicators (RSI, ATR, ADX) are recursive and only settle
# after several times their period, so the bot requests period * this.
WARMUP_MULTIPLIER=10
CANDLE_FLOOR=60
CANDLE_CEILING=1000

# --- zatrzymywanie bota -------------------------------------------------------
# Sekundy, jakie "python run.py --kill-all" daje innej kopii bota na grzeczne
# zamkniecie, zanim ubije ja na twardo.
KILL_GRACE_SECONDS=5

# --- strategia 4: scalp - powrot do sredniej na wstegach Bollingera ----------
# Srednia kroczaca ze wstegami odsunietymi o BB_STDEV odchylen standardowych.
# Kupuje zamkniecie rozciagniete pod dolna wstega, wychodzi gdy cena wroci do
# srodka. To opublikowane zastosowanie tego wskaznika, nie wymysl.
#
# Odchylenie standardowe mierzy cos, czego nie mierzy zadna z pozostalych
# strategii: jak daleko obecny ruch lezy poza normalna zmiennoscia tego
# rynku. Dlatego ta sama regula dziala na BTC i na memecoinie bez strojenia.
#
# 20 i 2.0 to wartosci domyslne Bollingera. Okno wstecz jest krotkie celowo:
# na swiecy 15-minutowej dotkniecie wstegi rozstrzyga sie w jeden, dwa slupki.
BB_PERIOD=20
BB_STDEV=2.0
BB_LOOKBACK_BARS=2
