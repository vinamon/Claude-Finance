# Copy this file to ".env" and fill in the three secrets. .env is gitignored
# and must never be committed.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)
#
# Everything below the secrets already holds a coherent starting set. The
# values are textbook, not clever, and they are a starting point for tuning
# rather than a strategy with a demonstrated edge.

# --- secrets -----------------------------------------------------------------
# Generated in Bybit AFTER switching to Demo Trading. Keys from the real
# account will not work on the demo host, by design.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Long random string, letters/digits/dash/underscore only, 1-64 chars.
# Subscribe to exactly this string in the ntfy app.
NTFY_TOPIC=

# --- the autostart switch ----------------------------------------------------
# true  = "python run.py" keeps cycling on its own
# false = "python run.py" does one cycle and exits
# Command line always wins: --loop / --once override this.
AUTOSTART=false
LOOP_INTERVAL_MINUTES=5

# --- safety ------------------------------------------------------------------
# true ignores the market completely and only enters with --force-entry.
DUMMY_MODE=false

# --- what to trade -----------------------------------------------------------
# Comma separated, ccxt format.
SYMBOLS=BTC/USDT:USDT

# trend | meanrev | breakout
STRATEGY=trend

# --- timeframe ---------------------------------------------------------------
# SMA 50/200 is a DAILY-chart signal in the textbooks. Run on 1h it is roughly
# eight times faster than intended and becomes noise; run on 1d it fires maybe
# once or twice a year, which is useless for a demo you want to watch. 4h sits
# between them: SMA50 covers about 8 days, SMA200 about 33, which is a normal
# swing-trading horizon in crypto and produces signals at a cadence you can
# actually observe.
ENTRY_TIMEFRAME=4h

# EXIT_TIMEFRAME is deliberately absent. Leaving it unset makes the exit
# inherit ENTRY_TIMEFRAME, which is the only way the exit is a true mirror of
# the entry: same indicator, same periods, same amount of history. Setting it
# shorter means the exit reads a fraction of the data the entry used and will
# close positions the entry trend still endorses, paying fees each time.

# --- risk --------------------------------------------------------------------
# Notional = qty * price, NOT the margin you put up.
# Margin used is roughly notional / leverage.
#
# 1000 USDT is 2% of the 50,000 USDT demo balance. It also buys headroom above
# Bybit's 0.001 BTC minimum lot: at ~79k that is 0.012 BTC, twelve times the
# minimum. A smaller notional such as 100 sits exactly ON the minimum and the
# order gets REFUSED as soon as BTC rises enough to price 100 USDT below one
# lot.
POSITION_NOTIONAL_USDT=1000

# 1 means no leverage. Leverage does not change the position size above, only
# how little margin backs it, which is to say how close liquidation sits.
LEVERAGE=1

# Fractions of the entry price. 0.05 = 5%.
#
# The stop loss is a disaster brake, not the primary exit: the strategy's own
# death-cross rule is what normally closes a position. A 2% stop on a 4h trend
# strategy fires on routine BTC noise long before the trend can play out, so
# it is set wide enough to stay out of the way. Take profit keeps a 1:2
# risk-to-reward ratio.
STOP_LOSS_PCT=0.05
TAKE_PROFIT_PCT=0.10

# Trailing stop. Bybit takes a PRICE DISTANCE, not a percentage, so this
# fraction is multiplied by the entry price before being sent.
#
# TRAILING_ACTIVATION_PCT must be >= TRAILING_STOP_PCT, and config.validate()
# refuses to run otherwise. Bybit puts the trail's first trigger at
# (activation - distance): with 5% and 3% that lands 2% ABOVE entry, so arming
# the trail locks in a profit. Reverse them and it lands below entry, turning
# the trail into an early loss that fires before the stop loss ever would.
TRAILING_STOP_PCT=0.03
TRAILING_ACTIVATION_PCT=0.05
