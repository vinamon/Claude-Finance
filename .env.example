# Copy this file to ".env" and fill it in. .env is gitignored and must never
# be committed: it holds your keys.
#
#   cp .env.example .env        (macOS / Linux)
#   copy .env.example .env      (Windows)

# --- secrets -----------------------------------------------------------------
# Generated in Bybit AFTER switching to Demo Trading. Keys from the real
# account will not work on the demo host, by design.
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Long random string, letters/digits/dash/underscore only, 1-64 chars.
# Subscribe to exactly this string in the ntfy app.
NTFY_TOPIC=

# --- the autostart switch ----------------------------------------------------
# true  = "python run.py" keeps cycling on its own
# false = "python run.py" does one cycle and exits
# Command line always wins: --loop / --once override this.
AUTOSTART=false
LOOP_INTERVAL_MINUTES=5

# --- safety ------------------------------------------------------------------
# true ignores the market completely and only enters with --force-entry.
# Leave it true until you have watched the whole pipeline work.
DUMMY_MODE=true

# --- what to trade -----------------------------------------------------------
# Comma separated, ccxt format. Start with ONE.
SYMBOLS=BTC/USDT:USDT

# trend | meanrev | breakout
STRATEGY=trend

# --- risk --------------------------------------------------------------------
# Notional = qty * price, NOT the margin you put up.
# Margin used is roughly notional / leverage.
POSITION_NOTIONAL_USDT=100
LEVERAGE=1

# Fractions of the entry price. 0.02 = 2%. Set to 0 to disable a leg.
STOP_LOSS_PCT=0.02
TAKE_PROFIT_PCT=0.04
TRAILING_STOP_PCT=0.015
TRAILING_ACTIVATION_PCT=0.01

# --- timeframes --------------------------------------------------------------
ENTRY_TIMEFRAME=1h
EXIT_TIMEFRAME=1m
